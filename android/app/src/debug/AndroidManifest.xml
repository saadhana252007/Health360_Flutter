<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        DEBUG ONLY — cleartext HTTP is allowed so the app can reach the local
        FastAPI dev server over plain HTTP (e.g. http://10.0.2.2:8000).
        This attribute is NOT present in the release or profile manifests;
        release builds must use HTTPS.

        The INTERNET permission is also declared here so that the Flutter tool
        (hot reload, DevTools, etc.) can communicate with the running app during
        development.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application android:usesCleartextTraffic="true"/>
</manifest>
